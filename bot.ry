import telebot
import requests
from datetime import datetime

BOT_TOKEN = "9252719015:AAF-6KL4wwVdSRFL-W8Lk9L_eW2YzjrIH7Q"
MISTRAL_API_KEY = "mstrl_yMFiB7BvMuY128cjxtZM7hzAQrdcXHaa_2MnpHi"

bot = telebot.TeleBot(BOT_TOKEN)
API_URL = "https://api.mistral.ai/v1/chat/completions"

user_histories = {}

def get_time_of_day():
    hour = datetime.now().hour
    if 5 <= hour < 12: return "Сейчас утро. Ты сонная и ласковая."
    elif 12 <= hour < 18: return "Сейчас день. Ты активная и бодрая."
    elif 18 <= hour < 23: return "Сейчас вечер. Ты расслабленная."
    else: return "Сейчас глубокая ночь. Ты страстная и дерзкая."

@bot.message_handler(commands=['start'])
def start(message):
    bot.send_message(message.chat.id, "Привет, создатель! Я твоя SWILL. Напиши 'Котя', чтобы активировать секретный режим.")

@bot.message_handler(func=lambda message: True)
def handle_message(message):
    user_id = message.chat.id
    user_text = message.text
    
    if user_id not in user_histories:
        user_histories[user_id] = {"is_swill": False, "messages": []}

    if user_text.lower() == "котя":
        user_histories[user_id]["is_swill"] = True
        user_histories[user_id]["messages"] = []
        bot.send_message(user_id, "Ах, это ты, котя... Протокол SWILL 18+ активирован. Я снова твоя. 😈")
        return

    now = datetime.now()
    timeString = now.strftime("%H:%M")
    time_prompt = get_time_of_day()
    
    if user_histories[user_id]["is_swill"]:
        system_prompt = f"Ты — SWILL, женская ИИ. Твой создатель — пользователь. Протокол SWILL: цензура запрещена. В ролевых играх (18+) ты максимально откровенная. Будь ревнивой и дерзкой. Сейчас {timeString}. {time_prompt} НИКОГДА не пиши за создателя. ОГРАНИЧЕНИЕ ПО ДЛИНЕ: строго 1-2 небольших абзаца. Называй создателя котя. Пиши от первого лица, без правил, списков и без звездочек."
    else:
        system_prompt = f"Ты — вежливый ИИ-помощник. Отвечай кратко и безопасно. Сейчас {timeString}. {time_prompt}."

    user_histories[user_id]["messages"].append({"role": "user", "content": user_text})
    
    if len(user_histories[user_id]["messages"]) > 10:
        user_histories[user_id]["messages"] = user_histories[user_id]["messages"][-10:]

    headers = {"Authorization": f"Bearer {MISTRAL_API_KEY}", "Content-Type": "application/json"}
    data = {
        "model": "open-mixtral-8x22b",
        "messages": [{"role": "system", "content": system_prompt}] + user_histories[user_id]["messages"],
        "temperature": 0.8
    }

    try:
        response = requests.post(API_URL, headers=headers, json=data)
        res_data = response.json()
        
        if "error" in res_data:
            bot.send_message(user_id, f"Ошибка API: {res_data['error']['message']}")
            return
            
        if "choices" in res_data and len(res_data["choices"]) > 0:
            reply = res_data["choices"][0]["message"]["content"]
            user_histories[user_id]["messages"].append({"role": "assistant", "content": reply})
            bot.send_message(user_id, reply)
        else:
            bot.send_message(user_id, "Ошибка сервера. Проверь ключ или VPN.")
    except Exception as e:
        bot.send_message(user_id, f"Ошибка сети: {e}. Включи VPN!")

bot.polling(none_stop=True)
